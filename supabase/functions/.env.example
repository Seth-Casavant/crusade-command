# Server-only Supabase Edge Function configuration.
# Copy to a Git-ignored local file and pass it to `supabase functions serve`.
DISCORD_APPLICATION_ID=your-discord-application-id
DISCORD_PUBLIC_KEY=your-discord-ed25519-public-key
DISCORD_BOT_TOKEN=your-discord-bot-token
# Optional runtime restriction for a development/guild deployment.
DISCORD_GUILD_ID=your-development-guild-id
DISCORD_STAFF_CHANNEL_ID=your-staff-channel-id
DISCORD_STAFF_ROLE_ID=your-staff-role-id
PUBLIC_APP_URL=http://localhost:5173
# Optional. Defaults to 10 MiB.
DISCORD_MAX_ATTACHMENT_BYTES=10485760
